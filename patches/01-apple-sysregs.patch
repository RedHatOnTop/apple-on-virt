diff --git a/target/arm/cpu.c b/target/arm/cpu.c
--- a/target/arm/cpu.c
+++ b/target/arm/cpu.c
@@ -2490,6 +2490,14 @@ static void arm_cpu_realizefn(DeviceState *dev, Error **errp)
     /* Some features automatically imply others: */
     arm_cpu_propagate_feature_implications(cpu);
 
+    /*
+     * Register Apple-specific system registers for XNU kernel compatibility.
+     * These are needed for macOS/Darwin to boot, as the kernel expects
+     * certain implementation-defined registers to be present.
+     */
+    extern void define_apple_cp_regs(ARMCPU *cpu);
+    define_apple_cp_regs(cpu);
+
     if (arm_feature(env, ARM_FEATURE_AARCH64) &&
         cpu->has_vfp != cpu->has_neon) {
         /*
