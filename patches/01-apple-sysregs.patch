+/* Generic read/write functions for Apple registers */
+#define APPLE_SYSREG_FUNCS(name, field) \
+static uint64_t apple_##name##_read(CPUARMState *env, const ARMCPRegInfo *ri) \
+{ \
+    ARMCPU *cpu = env_archcpu(env); \
+    return cpu->field; \
+} \
+static void apple_##name##_write(CPUARMState *env, const ARMCPRegInfo *ri, \
+                                  uint64_t value) \
+{ \
+    ARMCPU *cpu = env_archcpu(env); \
+    cpu->field = value; \
+}
